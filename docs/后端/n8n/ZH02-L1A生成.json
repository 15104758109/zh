    {
      "parameters": {
        "jsCode": "// 校验 LLM 输出的 JSON 格式是否符合 L1A 结构\nconst rawText = items[0].json.output || '';\ntry {\n  const l1aCandidates = JSON.parse(rawText);\n  return l1aCandidates.map(item => ({\n    json: {\n      ...item,\n      isValid: !!(item.conflict_seed_id && item.conflict_type && item.description)\n    }\n  }));\n} catch (e) {\n  return [{ json: { error: 'Invalid JSON format', raw: rawText, isValid: false } }];\n}"
      },
      "id": "e19786bb-39d3-4977-a304-84b7677f38e3",
      "name": "JSON修复与候选结构校验",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        944,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// 修复商业筛选后输出的 JSON 结果\nconst rawText = items[0].json.output || '';\ntry {\n  const candidates = JSON.parse(rawText);\n  return candidates.map(item => ({ json: item }));\n} catch (e) {\n  return [{ json: { error: 'Invalid JSON format', raw: rawText } }];\n}"
      },
      "id": "e0ece32d-9575-4438-a6ea-4b9dbdcacd37",
