        "jsCode": "// 校验三线排序的 JSON 结构并进行容错修复\nconst input = $input.first().json;\nlet l1a_seq = [];\ntry {\n  const rawText = input.output || input.text || '';\n  const match = rawText.match(/\\[\\s*\\{[\\s\\S]*\\}\\s*\\]/);\n  if (match) {\n    l1a_seq = JSON.parse(match[0]);\n  } else {\n    l1a_seq = JSON.parse(rawText);\n  }\n} catch (e) {\n  l1a_seq = input.l1a_seq || [];\n}\nreturn [{\n  json: {\n    ...input,\n    l1a_seq: l1a_seq,\n    isValid: Array.isArray(l1a_seq) && l1a_seq.length > 0\n  }\n}];"
      },
