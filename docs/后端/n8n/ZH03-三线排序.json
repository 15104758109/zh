      "parameters": {
        "jsCode": "// 修复审计 Agent 输出的 JSON\nconst input = $input.first().json;\nlet auditResult = { pass: false, reason: 'parse error' };\ntry {\n  const text = input.output || input.text || '';\n  const match = text.match(/\\{\\s*\"pass\"[\\s\\S]*\\}/);\n  if (match) {\n    auditResult = JSON.parse(match[0]);\n  } else {\n    auditResult = JSON.parse(text);\n  }\n} catch (e) {\n  if (input.text && input.text.includes('通过')) {\n    auditResult = { pass: true, reason: input.text };\n  } else {\n    auditResult = { pass: false, reason: '审计解析失败: ' + e.message };\n  }\n}\nreturn [{\n  json: {\n    ...input,\n    auditResult: auditResult\n  }\n}];"
