{
  "schema_version": "g07-autonomy-policy/v2",
  "control_anchor": "G07::AUTONOMY",
  "phase": "G07_A_CONTROL_PLANE_ONLY",
  "g07_gate_required": "APPROVED",
  "product_task_execution_allowed": false,
  "integration_branch": "autonomy/integration",
  "concurrency": {
    "max_writers": 1,
    "max_read_only_reviewers": 2,
    "default_lease_seconds": 900,
    "lock_stale_ms": 30000
  },
  "retry_policy": {
    "max_rework": 3,
    "max_replan": 2,
    "critical_path_on_exhaustion": "CREATOR_REQUIRED",
    "noncritical_on_exhaustion": "BLOCKED"
  },
  "budget": {
    "notify_ratio": 0.8,
    "hard_stop_ratio": 1.0,
    "limits": {
      "tokens": null,
      "elapsed_ms": null,
      "known_cost": null
    },
    "unknown_cost_is_zero": false
  },
  "models": {
    "MODEL::CODE_HIGH": {
      "requested_capability": "current strongest code reasoning model with high reasoning",
      "fallback": "current strongest available model in an independent role session",
      "must_record_actual_model_when_visible": true
    },
    "MODEL::CODE_MEDIUM": {
      "requested_capability": "standard code reasoning model with medium reasoning",
      "fallback": "current strongest available model in an independent role session",
      "must_record_actual_model_when_visible": true
    }
  },
  "event_integrity": {
    "algorithm": "HMAC-SHA256",
    "key_file": "integrity.key",
    "key_must_be_ignored": true,
    "semantic_replay_required": true
  },
  "identity_attestation": {
    "required": true,
    "provider": "UNAVAILABLE",
    "missing_provider_decision": "ENVIRONMENT_APPROVAL_REQUIRED",
    "caller_declared_actor_or_session_is_evidence": false
  },
  "critical_path": {
    "derivation": "DEPENDENCY_ANCESTRY_OF_REGISTERED_PATH_ENDPOINTS_AND_CRITICAL_TASKS",
    "literal_task_id_match_only": false
  },
  "replan_categories": {
    "A": "technical implementation change inside the same approved write scope",
    "B": "technical steps or evidence redesign with business result, dependencies and owner unchanged",
    "C": "business, global decision, G04 or Task meaning, dependency, owner or Gate change",
    "D": "tool, platform or environment blockage"
  },
  "hard_stop_actions": [
    "REAL_PROJECT_MODEL_CALL",
    "PAID_TEST",
    "PUSH",
    "DEPLOY",
    "PRODUCTION_WRITE",
    "CREDENTIAL_ACCESS"
  ],
  "forbidden_automatic_actions": [
    "MERGE_TO_MAIN",
    "WRITE_G07_GATE_APPROVED",
    "PUSH",
    "DEPLOY",
    "PRODUCTION_WRITE",
    "CREDENTIAL_ACCESS"
  ]
}
