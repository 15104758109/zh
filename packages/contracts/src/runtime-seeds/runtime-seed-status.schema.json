{
  "$id": "runtime-seeds/runtime-seed-status",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": { "enum": ["READY", "BLOCKED"] },
    "code": { "enum": ["REQUIRED_SKILL_MISSING"] },
    "genre_main": { "type": "string", "minLength": 1 }
  },
  "required": ["status", "genre_main"],
  "allOf": [{ "if": { "properties": { "status": { "const": "BLOCKED" } } }, "then": { "required": ["code"] } }]
}
