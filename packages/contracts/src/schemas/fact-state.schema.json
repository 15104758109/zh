{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zhreplan:contract:fact-state:1",
  "title": "FactState",
  "type": "object",
  "additionalProperties": false,
  "required": ["fact_id", "fact_version", "state", "state_version"],
  "properties": {
    "fact_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "fact_version": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "enum": ["candidate", "shadow", "formal"]
    },
    "state_version": {
      "type": "integer",
      "minimum": 0
    },
    "replaces_version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["fact_version"],
        "properties": {
          "fact_version": {
            "type": "integer",
            "minimum": 2
          }
        }
      },
      "then": {
        "required": ["replaces_version"]
      },
      "else": {
        "not": {
          "required": ["replaces_version"]
        }
      }
    }
  ]
}
