{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zhreplan:contract:record-envelope:1",
  "title": "MinimalRecordEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope_version",
    "record_id",
    "recorded_at",
    "owner",
    "local_operator_id",
    "trace_id",
    "data_schema_id",
    "data_schema_version",
    "data"
  ],
  "properties": {
    "envelope_version": {
      "const": 1
    },
    "record_id": {
      "$ref": "#/$defs/stableId"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "owner": {
      "type": "string",
      "pattern": "^(?:FP::FP[0-9]{3}-[0-9]{2}|GLOBAL::[A-Z][A-Z0-9_]*)$"
    },
    "local_operator_id": {
      "$ref": "#/$defs/stableId"
    },
    "book_id": {
      "$ref": "#/$defs/stableId"
    },
    "run_id": {
      "$ref": "#/$defs/stableId"
    },
    "chapter_id": {
      "$ref": "#/$defs/stableId"
    },
    "candidate_id": {
      "$ref": "#/$defs/stableId"
    },
    "audit_attempt_id": {
      "$ref": "#/$defs/stableId"
    },
    "model_attempt_id": {
      "$ref": "#/$defs/stableId"
    },
    "retry_index": {
      "type": "integer",
      "minimum": 0
    },
    "trace_id": {
      "$ref": "#/$defs/stableId"
    },
    "config_ref": {
      "$ref": "urn:zhreplan:contract:config-version-ref:1"
    },
    "budget_ref": {
      "$ref": "urn:zhreplan:contract:budget-version-ref:1"
    },
    "data_schema_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "data_schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "data": true
  },
  "allOf": [
    {
      "if": {
        "required": ["retry_index"]
      },
      "then": {
        "required": ["model_attempt_id"]
      }
    }
  ],
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    }
  }
}
