{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zhreplan:contract:schema-descriptor:1",
  "title": "SchemaDescriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "version",
    "schema_uri",
    "draft",
    "owner",
    "schema_path",
    "sha256",
    "status",
    "deprecated_fields"
  ],
  "properties": {
    "schema_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "schema_uri": {
      "type": "string",
      "pattern": "^urn:zhreplan:contract:[a-z][a-z0-9-]{2,63}:[1-9][0-9]*$"
    },
    "draft": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "owner": {
      "type": "string",
      "pattern": "^(?:FP::FP[0-9]{3}-[0-9]{2}|GLOBAL::[A-Z][A-Z0-9_]*)$"
    },
    "schema_path": {
      "type": "string",
      "pattern": "^src/schemas/.+\\.schema\\.json$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": ["active", "deprecated"]
    },
    "replaces_version": {
      "type": "integer",
      "minimum": 1
    },
    "replacement_version": {
      "type": "integer",
      "minimum": 1
    },
    "deprecated_fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deprecatedField"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["version"],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 2
          }
        }
      },
      "then": {
        "required": ["replaces_version"]
      }
    },
    {
      "if": {
        "required": ["status"],
        "properties": {
          "status": {
            "const": "deprecated"
          }
        }
      },
      "then": {
        "required": ["replacement_version"]
      }
    }
  ],
  "$defs": {
    "deprecatedField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "since_version"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "format": "json-pointer"
        },
        "since_version": {
          "type": "integer",
          "minimum": 1
        },
        "replacement_path": {
          "type": "string",
          "minLength": 1,
          "format": "json-pointer"
        }
      }
    }
  }
}
