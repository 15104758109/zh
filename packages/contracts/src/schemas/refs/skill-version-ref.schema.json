{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zhreplan:contract:skill-version-ref:1",
  "title": "SkillVersionRef",
  "type": "object",
  "additionalProperties": false,
  "required": ["skill_id", "version", "source"],
  "properties": {
    "skill_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "source": {
      "enum": ["system_builtin", "user_managed"]
    }
  }
}
