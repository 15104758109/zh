{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhreplan.local/contracts/new-book/create-book-error/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "error"],
  "properties": { "ok": { "const": false }, "error": { "type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": { "code": { "enum": ["INVALID_REQUEST", "DUPLICATE_TITLE", "WRITE_FAILED"] }, "message": { "type": "string", "minLength": 1, "maxLength": 160 } } } }
}
