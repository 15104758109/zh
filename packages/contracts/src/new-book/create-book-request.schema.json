{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhreplan.local/contracts/new-book/create-book-request/2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "local_operator_id",
    "correlation_id",
    "idempotency_key",
    "title",
    "intent_json",
    "forbid_json",
    "selling_points_json",
    "target_words",
    "chapter_words",
    "characters",
    "relations",
    "world_states",
    "world_bindings",
    "initial_memories",
    "initial_l1a"
  ],
  "properties": {
    "local_operator_id": { "type": "string", "format": "uuid" },
    "correlation_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "idempotency_key": { "$ref": "#/$defs/idempotencyKey" },
    "title": { "type": "string", "minLength": 1 },
    "intent_json": {
      "type": "object",
      "minProperties": 1,
      "required": ["genre_main", "target_emotion"],
      "properties": {
        "genre_main": { "enum": ["\u79d1\u5e7b", "\u7384\u5e7b", "\u8a00\u60c5", "\u6b66\u4fa0", "\u6050\u6016", "\u540c\u4eba"] },
        "target_emotion": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" }
      },
      "additionalProperties": true
    },
    "forbid_json": { "type": "object" },
    "selling_points_json": { "type": "array", "minItems": 1 },
    "target_words": { "type": "integer", "minimum": 1 },
    "chapter_words": { "type": "integer", "minimum": 1 },
    "commercial_score": { "type": "integer", "minimum": 0, "maximum": 10 },
    "characters": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/character" } },
    "relations": { "type": "array", "items": { "$ref": "#/$defs/relation" } },
    "world_states": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/worldState" } },
    "world_bindings": { "type": "array", "items": { "$ref": "#/$defs/worldBinding" } },
    "initial_memories": { "type": "array", "items": { "$ref": "#/$defs/initialMemory" } },
    "initial_l1a": { "$ref": "#/$defs/initialL1a" }
  },
  "$defs": {
    "idempotencyKey": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "nonEmptyObject": { "type": "object", "minProperties": 1 },
    "fiveLayers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["L0", "L1", "L2", "L3"],
      "properties": {
        "L0": { "$ref": "#/$defs/nonEmptyObject" },
        "L1": { "$ref": "#/$defs/nonEmptyObject" },
        "L2": { "$ref": "#/$defs/nonEmptyObject" },
        "L3": { "$ref": "#/$defs/nonEmptyObject" }
      }
    },
    "knowledgeBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["knows", "unknown", "false_belief", "reasonable_suspect"],
      "properties": {
        "knows": { "type": "array" },
        "unknown": { "type": "array" },
        "false_belief": { "type": "array" },
        "reasonable_suspect": { "type": "array" }
      }
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_ref", "char_name", "char_type", "five_layers_json", "knowledge_boundary_json", "arc_json"],
      "properties": {
        "client_ref": { "type": "string", "minLength": 1 },
        "char_name": { "type": "string", "minLength": 1 },
        "char_type": { "enum": ["protagonist", "supporting", "ensemble", "antagonist"] },
        "gender": { "type": ["string", "null"] },
        "five_layers_json": { "$ref": "#/$defs/fiveLayers" },
        "knowledge_boundary_json": { "$ref": "#/$defs/knowledgeBoundary" },
        "arc_json": { "$ref": "#/$defs/nonEmptyObject" },
        "conflict_seed_json": { "type": "object" }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "char_a_ref", "char_b_ref", "trust", "intimacy", "power_balance", "dependence",
        "hostility", "common_goal", "secret_known", "emotional_bond", "relation_type",
        "relation_hierarchy", "change_event_json"
      ],
      "properties": {
        "char_a_ref": { "type": "string", "minLength": 1 },
        "char_b_ref": { "type": "string", "minLength": 1 },
        "trust": { "type": "integer", "minimum": -100, "maximum": 100 },
        "intimacy": { "type": "integer", "minimum": -100, "maximum": 100 },
        "power_balance": { "type": "integer", "minimum": -100, "maximum": 100 },
        "dependence": { "type": "integer", "minimum": -100, "maximum": 100 },
        "hostility": { "type": "integer", "minimum": 0, "maximum": 100 },
        "common_goal": { "type": "integer", "minimum": 0, "maximum": 100 },
        "secret_known": { "type": "integer", "minimum": 0, "maximum": 100 },
        "emotional_bond": { "type": "integer", "minimum": -100, "maximum": 100 },
        "relation_type": { "type": "string", "minLength": 1 },
        "relation_hierarchy": { "type": "string", "minLength": 1 },
        "relation_origin": { "type": ["string", "null"] },
        "relation_overview": { "type": ["string", "null"] },
        "change_event_json": { "$ref": "#/$defs/nonEmptyObject" }
      }
    },
    "worldState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["board_type", "atom_type", "atom_key", "atom_value_jsonb", "affordance_dims"],
      "properties": {
        "board_type": { "enum": ["rule", "geography", "resource", "faction", "profession", "monster", "event"] },
        "atom_type": { "enum": ["rule", "fact", "resource", "event", "faction", "job", "monster", "geo"] },
        "atom_key": { "type": "string", "minLength": 1 },
        "atom_value_jsonb": { "$ref": "#/$defs/nonEmptyObject" },
        "affordance_dims": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "source_type": { "type": "string" },
        "knowledge_boundary_json": { "type": "object" },
        "apply_scope_json": { "type": "object" },
        "violate_cost_json": { "type": "object" }
      },
      "allOf": [{
        "if": { "properties": { "atom_type": { "const": "fact" } }, "required": ["atom_type"] },
        "then": { "required": ["knowledge_boundary_json"] }
      }]
    },
    "worldBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_ref_type", "from_ref_id", "to_ref_type", "to_ref_id", "binding_type", "binding_strength"],
      "properties": {
        "from_ref_type": { "enum": ["world", "character"] },
        "from_ref_id": { "type": "string", "minLength": 1 },
        "to_ref_type": { "enum": ["world", "character"] },
        "to_ref_id": { "type": "string", "minLength": 1 },
        "binding_type": { "type": "string", "minLength": 1 },
        "binding_strength": { "enum": ["strong", "medium", "weak", "\u5f3a", "\u4e2d", "\u5f31"] },
        "setting_layer": { "type": "string" }
      }
    },
    "initialMemory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["char_ref", "memory_type", "memory_content", "truth_status"],
      "properties": {
        "char_ref": { "type": "string", "minLength": 1 },
        "memory_type": { "enum": ["event", "emotion", "knowledge", "relationship"] },
        "memory_content": { "type": "string", "minLength": 1 },
        "truth_status": { "enum": ["true", "misremembered", "false"] },
        "importance": { "type": "number", "minimum": 0, "maximum": 1 },
        "decay_rate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "initialL1a": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "l1a_index", "l1a_name", "scene_location", "conflict_background", "escalation_path", "stakes",
        "irreversible_consequence", "plot_emotion_commit", "arc_requirement",
        "info_reveal_boundary", "role_arc_json", "participant_char_refs"
      ],
      "properties": {
        "l1a_index": { "type": "integer", "minimum": 1 },
        "l1a_name": { "type": "string", "minLength": 1 },
        "scene_location": { "type": "string", "minLength": 1 },
        "conflict_background": { "type": "string", "minLength": 1 },
        "escalation_path": { "type": "string", "minLength": 1 },
        "stakes": { "type": "string", "minLength": 1 },
        "irreversible_consequence": { "type": "string", "minLength": 1 },
        "plot_emotion_commit": { "$ref": "#/$defs/nonEmptyObject" },
        "arc_requirement": { "$ref": "#/$defs/nonEmptyObject" },
        "info_reveal_boundary": { "$ref": "#/$defs/nonEmptyObject" },
        "role_arc_json": { "$ref": "#/$defs/nonEmptyObject" },
        "participant_char_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
