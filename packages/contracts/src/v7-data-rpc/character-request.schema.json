{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zhreplan:contract:rpc-commit-character-settings:2",
  "type": "object",
  "additionalProperties": false,
  "required": ["local_operator_id", "book_id", "idempotency_key", "character_candidate_ids"],
  "properties": {
    "local_operator_id": { "type": "string", "format": "uuid" },
    "book_id": { "type": "string", "format": "uuid" },
    "correlation_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "idempotency_key": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "character_candidate_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" }
    },
    "relation_candidate_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" }
    },
    "binding_candidate_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" }
    },
    "initial_memories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["char_id", "memory_type", "memory_content", "truth_status"],
        "properties": {
          "char_id": { "type": "string", "format": "uuid" },
          "memory_type": { "enum": ["event", "emotion", "knowledge", "relationship"] },
          "memory_content": { "type": "string", "minLength": 1 },
          "truth_status": { "enum": ["true", "misremembered", "false"] },
          "importance": { "type": "number", "minimum": 0, "maximum": 1 },
          "decay_rate": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
