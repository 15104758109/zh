{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zhreplan:contract:v7-create-book-request:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["local_operator_id", "correlation_id", "idempotency_key", "title", "intent_json", "forbid_json", "characters", "relations", "world_atoms", "world_bindings", "initial_l1a"],
  "properties": {
    "local_operator_id": { "type": "string", "format": "uuid" },
    "correlation_id": { "type": "string", "minLength": 1 },
    "idempotency_key": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "title": { "type": "string", "minLength": 1 },
    "intent_json": { "type": "object" },
    "forbid_json": { "type": "object" },
    "selling_points_json": { "type": "array" },
    "target_words": { "type": "integer", "minimum": 1 },
    "chapter_words": { "type": "integer", "minimum": 1 },
    "commercial_score": { "type": "integer", "minimum": 0, "maximum": 10 },
    "characters": { "type": "array", "minItems": 1 },
    "relations": { "type": "array" },
    "world_atoms": { "type": "array", "minItems": 1 },
    "world_bindings": { "type": "array" },
    "initial_memories": { "type": "array" },
    "initial_l1a": { "type": "array", "minItems": 1 }
  }
}
