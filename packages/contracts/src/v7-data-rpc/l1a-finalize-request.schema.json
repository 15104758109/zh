{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zhreplan:contract:rpc-finalize-l1a:2",
  "type": "object",
  "additionalProperties": false,
  "required": ["local_operator_id", "book_id", "idempotency_key", "ordered_l1a_ids", "design_fingerprint"],
  "properties": {
    "local_operator_id": { "type": "string", "format": "uuid" },
    "book_id": { "type": "string", "format": "uuid" },
    "correlation_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "idempotency_key": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "ordered_l1a_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" }
    },
    "design_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
