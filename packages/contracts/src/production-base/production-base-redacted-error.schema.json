{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zhreplan:contract:production-base-redacted-error:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["correlation_id", "redacted_error"],
  "properties": {
    "correlation_id": { "const": "unavailable" },
    "redacted_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "const": "INVALID_REQUEST" },
        "message": { "const": "The request could not be accepted." }
      }
    }
  }
}
